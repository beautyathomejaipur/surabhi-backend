DATABASE_URL="postgresql://user:password@localhost:5432/surabhi_db?schema=public"
PORT=3001
JWT_SECRET=

# Super Admin — the single fixed operations-console login (see
# src/modules/admin-auth). SUPER_ADMIN_PASSWORD_HASH is a scrypt "salt:hash"
# pair, generated with hashPassword() from src/lib/password.ts — never put
# a plaintext password here.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD_HASH=

# Google Sign-In (Customer login) — OAuth 2.0 Client ID from Google Cloud
# Console (APIs & Services > Credentials). Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID
# on the frontend, or ID token verification below will reject every login.
GOOGLE_CLIENT_ID=

# Resend (transactional email — sign-in codes + welcome). Create a key at resend.com/api-keys.
# MAIL_FROM must use a domain verified in Resend; the default onboarding@resend.dev only
# delivers to your own Resend account email, so it is for testing only.
RESEND_API_KEY=
MAIL_FROM="Surabhi <hello@yourdomain.com>"
MAIL_REPLY_TO=
APP_URL=https://surabhicatering.com

# ImageKit — used for all category/menu item/outlet image uploads (resized +
# compressed to WebP server-side before upload). Each upload type gets its
# own folder in the media library: /surabhi/categories, /surabhi/menu-items,
# /surabhi/outlets.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Local testing only — see src/lib/mail/client.ts. Leave unset in production.
# MAIL_DEV_FALLBACK=true

# Production hardening (optional in local dev)
# Comma-separated origins allowed to call the API, e.g. the live website.
# CORS_ORIGINS="https://surabhicatering.com,https://www.surabhicatering.com"
# Set to 1 when running behind a reverse proxy/load balancer so rate limits see real visitor IPs.
# TRUST_PROXY=1
